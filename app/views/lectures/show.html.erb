<% content_for :meta_title do %>
  <%= @meta_title %>
<% end %>

<% content_for :meta_image do %>
  <%= @lecture.meta_image %>
<% end %>

<div class="lecture-wrapper">
  <div class="container">
    <div class="row">
      <!-- ========== BORDER COLOR ========== -->
      <div class="hidden-xs border <%= @lecture_course.category.tag %>"></div>
      
      <!-- ========== CHECKBOX ========== -->
      <% if current_user %>
        <div class="sidebar-like checkbox" id="like-<%= @lecture_course.id %>">
          <%= render '/courses/like', course: @lecture_course %>
        </div>
      <% else %>
        <div class="sidebar-like checkbox" data-toggle="modal" data-target="#myLoginModal">
          <i>Garder dans Mes Cours ?</i>
        </div>
      <% end %>

      <!-- ========== SIDE MENU ========== -->
      <nav class="col-xs-12 col-sm-12 col-md-3">
        <div class="lecture-menu">
          <% @lectures.each do |lecture| %>
            <ul>
              <%= link_to lecture_path(lecture) do %>
                <% if lecture.id.to_s == params[:id] %>
                  <li class="lecture-link active"><%= lecture.title.gsub(/<.*?>/,"") %>
                    <%= "🔒" unless policy(lecture).watch_video? %>
                  </li>
                <% else %>
                  <li class="lecture-link"><%= lecture.title.gsub(/<.*?>/,"") %>
                    <%= "🔒" unless policy(lecture).watch_video? %>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </nav>

      <!-- ========== VIDEO PAGE ========== -->
      <div class="col-xs-12 col-md-9">
        <div class="lecture-show">
          
          <!-- ========== BLOC VIDÉO ET ENCART LATÉRAL DYNAMIQUE ========== -->
          <% if @lecture.respond_to?(:short) && @lecture.short? %>
            <!-- CAS 1 : FORMAT SHORT (DISPOSITION 2 COLONNES SUR PC/TABLETTE) -->
            <div class="row short-desktop-container">
              
              <!-- Colonne Gauche : Le lecteur vidéo vertical -->
              <div class="col-xs-12 col-sm-6 col-md-5">
                <div id="video-player-box" class="video-player-container is-vertical-short-wrapper">
                  <% if policy(@lecture).watch_video? %>
                    <div class="embed-responsive embed-responsive-16by9 lecture-video is-vertical-short">
                      <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/<%= @lecture.video %>?rel=0&showinfo=0" frameborder="0" allowfullscreen></iframe>
                    </div>
                  <% else %>
                    <%= render 'shared/planmodal' %>

                    <div data-toggle="modal" data-target="#PlanModal" class="video-placeholder-container">
                      <div class="video-vignette-locked is-vertical-short">
                        <div class="video-bg-image" style="background-image: url('https://img.youtube.com/vi/<%= @lecture.video %>/maxresdefault.jpg');"></div>
                        <div class="video-overlay"></div>
                        <div class="video-locked-content">
                          <div class="play-button-wrapper">
                            <div class="youtube-play-btn"><div class="yt-triangle"></div></div>
                            <span class="lock-badge">🔒</span>
                          </div>
                          <div class="video-title">
                            <%= @lecture.title.gsub(/<[^>]+>/, '').strip %>
                          </div>
                          <div class="video-subtitle">
                            Ton cours complet en vidéo
                            <% if @lecture.respond_to?(:duration) && @lecture.duration.present? %>
                              (<%= @lecture.duration %> min)
                            <% end %>
                          </div>
                        </div>
                      </div>
                      <p class="lecture-note-locked">
                        🔒 Débloque la vidéo et télécharge les fiches PDF rédigées dans l'onglet Documents ⬇️
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Colonne Droite : Appel du partial (Masqué sur mobile via hidden-xs) -->
              <div class="col-xs-12 col-sm-6 col-md-7 hidden-xs">
                <%= render 'lectures/short_sidebar', lecture: @lecture, lectures: @lectures, documents: @documents %>
              </div>

            </div>

          <% else %>
            <!-- CAS 2 : FORMAT PAYSAGE STANDARD -->
            <div id="video-player-box" class="video-player-container">
              <% if policy(@lecture).watch_video? %>
                <div class="embed-responsive embed-responsive-16by9 lecture-video">
                  <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/<%= @lecture.video %>?rel=0&showinfo=0" frameborder="0" allowfullscreen></iframe>
                </div>
              <% else %>
                <%= render 'shared/planmodal' %>

                <div data-toggle="modal" data-target="#PlanModal" class="video-placeholder-container">
                  <div class="video-vignette-locked">
                    <div class="video-bg-image" style="background-image: url('https://img.youtube.com/vi/<%= @lecture.video %>/maxresdefault.jpg');"></div>
                    <div class="video-overlay"></div>
                    <div class="video-locked-content">
                      <div class="play-button-wrapper">
                        <div class="youtube-play-btn"><div class="yt-triangle"></div></div>
                        <span class="lock-badge">🔒</span>
                      </div>
                      <div class="video-title">
                        <%= @lecture.title.gsub(/<[^>]+>/, '').strip %>
                      </div>
                      <div class="video-subtitle">
                        Ton cours complet en vidéo
                        <% if @lecture.respond_to?(:duration) && @lecture.duration.present? %>
                          (<%= @lecture.duration %> min)
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <p class="lecture-note-locked">
                    🔒 Débloque la vidéo — ⬇️ Télécharge les fiches PDF rédigées dans l'onglet Documents
                  </p>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- ====== Lien vers l'Admin ====== -->
          <% if current_user && current_user.admin %>
            <%= link_to rails_admin.edit_path(model_name: 'lecture', id: @lecture.id) do %>
              <p id="lecture-admin">Edit</p>
            <% end %>
          <% end %>

          <!-- ========== TABS ========== -->
          <div class= "tabs">
              <span class="tab active tab-description <%= @lecture_course.category.tag %>" href="#">
                <label for="description">CONTENU</label>
              </span>
            <% if @documents != [] %>
              <span class="tab tab-documents <%= @lecture_course.category.tag %>" href="#">
                <label class="hidden-sm hidden-md hidden-lg hidden-xl" for="documents">DOCS</label>
                <label class="hidden-xs"for="documents">DOCUMENTS</label>
              </span>
            <% end %>
              <% @documents.each do |document| %>
                <% if document.title.include?("✅") %>
                  <% if current_user && current_user.pricing.present? %>
                    <%= link_to document_path(document, class:"tab-quiz") do %>
                      <span class="tab tab-quiz <%= @lecture_course.category.tag %>" href="#">
                        <label for="documents">
                          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;QUIZ&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        </label>
                      </span>
                    <% end %>
                  <% else %>
                    <%= render 'shared/planmodal' %>
                      <a data-toggle="modal" data-target="#PlanModal">
                        <span class="tab tab-quiz <%= @lecture_course.category.tag %>" href="#">
                          <label for="documents">
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;QUIZ&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                          </label>
                        </span>
                      </a>
                      </div>
                  <% end %>
                <% end %>
            <% end %>
          </div>

          <!-- ========== TAB CONTENT ========== -->
          <div class="lecture-content">
            <!-- === DESCRIPTION === -->
            <div class="hidden-xs"></div>
            <% if policy(@lecture).watch_video? %>
              <section class="lecture-description content">
                <%= cl_image_tag @lecture.course.picture, class: "list-cover", alt: "Couverture pour "+@lecture.course.title, width: 178, height: 267, crop: :fill %>
                <%= @description_for_subscribers %>
                <br>
                <img src="<%= @lecture.picture %>" width="100%">
                <br>
                <p class="lecture-legend"><sub><%= @legend %></sub></p>
              </section>
            <% else %>
              <section class="lecture-description content">
                <%= cl_image_tag @lecture.course.picture, class: "list-cover", alt: "Couverture pour "+@lecture.course.title, width: 178, height: 267, crop: :fill %>
                <%= render_content_with_first_cta(@description_for_free) %>
                <%= render 'lectures/cta_footer' %>
                <br>
                <img src="<%= @lecture.picture %>" width="100%">
                <br>
                <p class="lecture-legend"><sub><%= @legend %></sub></p>
              </section>
            <% end %>

            <!-- === DOCUMENTS === -->
            <section class="lecture-documents content" id="documents">
              <% if current_user && current_user.pricing.present? %>
                <% @documents.each do |document| %>
                  <p><%= link_to document.title, document_path(document)%></p>
                <% end %>
              <% else %>
                <% @documents.each do |document| %>
                  <% if document.payment %>
                    <p data-toggle="modal" data-target="#PlanModal">
                      <%= link_to document.title, '#documents' %> 🔒
                    </p>
                  <% else %>
                    <p><%= link_to document.title, document_path(document)%></p>
                  <% end %>
                <% end %>

              <% end %>
            </section>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========== JS SEULEMENT POUR LES ONGLETS ========== -->
<% content_for(:js) do %>
  <%= javascript_tag do %>
    $(document).ready(function() {
      $('.tab-description').on('click', function(event) {
        $(".content").hide();
        $(".lecture-description").show();
        $(".tab").removeClass('active');
        $(this).addClass('active');
      });
      $('.tab-documents').on('click', function(event) {
        $(".content").hide();
        $(".lecture-documents").show();
        $(".tab").removeClass('active');
        $(this).addClass('active');
      });
    });
  <% end %>
<% end %>