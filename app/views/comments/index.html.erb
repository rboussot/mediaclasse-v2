<div class="lecture-wrapper">
  <div class="container">
    <div class= "row">
    <div class="hidden-xs border profile"></div><br>
      <% if user_signed_in? %>
        <h3 class="text-center">Livre d'or</h3><br>
      <% else %>
        <h3 class="text-center">Livre d'or</h3><br>
        <div class= "lecture-discussion" data-toggle="modal" data-target="#myLoginModal">
          <div class="loginsignup">
              <%= cl_image_tag "https://s3-eu-west-1.amazonaws.com/acquis/avatars/"+"%03d" % rand(1000)+".jpg", class: "avatar-list", crop: :fill %>
              <h5>🙏 Connecte-toi pour commenter le Livre d'Or !</h5>
              <%= form_for @comment, remote: true do |f| %>
              <%= f.text_area :content, class: "lecture-form" %>
              <%= f.submit class: "lecture-submit", value: "Publier" %>
      <% end %>
          </div>
        </div>
      <% end %>
      <div id="lecture-comments">
        <div id="comment-form">
          <%= render 'form' %>
        </div>

        <div id="comments">
          <% if @comments.blank? %>
            <h4 class="text-center">Soyez le premier à laisser un commentaire !</h4>
          <% else %>
            <% @comments.each do |comment| %>
              <%= render 'show', comment: comment %>
            <% end %>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>
