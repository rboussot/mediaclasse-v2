<% if notice %>
  <div class="alert alert-info alert-dismissible pointer" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="alert alert-warning alert-dismissible pointer" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <%= alert %>
  </div>
<% end %>
<% content_for(:js) do %>
  <%= javascript_tag do %>
    $(document).ready(function() {
      $('.alert-dismissible').on('click', function(event) {
        $(this).fadeOut();
        });
    });
  <% end %>
<% end %>