<div class = "banner-cookie pointer">
<button type="button" class="close" data-dismiss="alert" aria-label="Close">
  <span aria-hidden="true">&times;</span>
</button>
  <!-- <div class= "banner-close">X</div> -->
  En poursuivant votre navigation sur le site, vous acceptez l'utilisation de cookies : pour personnaliser votre navigation et mesurer la fréquentation (de façon anonyme).
</div>

<% content_for(:js) do %>
  <%= javascript_tag do %>
    $(document).ready(function() {
      $('.banner-cookie').on('click', function(event) {
        $(this).fadeOut();
        });
    });
  <% end %>
<% end %>
